[Unit]
Description=IPVanish OpenVPN connection
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=IPVANISH_CONFIG_DIR=/home/ces/Downloads/ipvanish-configs
Environment=IPVANISH_AUTH_FILE=/home/ces/.config/ipvanish/auth.txt
Environment=IPVANISH_MATCH=random
ExecStart=/home/ces/.local/bin/ipvanish-system-start
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
