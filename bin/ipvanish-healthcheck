#!/usr/bin/env bash
set -euo pipefail

service_name="${IPVANISH_SERVICE_NAME:-ipvanish.service}"
expected_org="${VPN_EXPECTED_ORG:-}"
org="$(curl -fsS --max-time 10 https://ipinfo.io/org 2>/dev/null || true)"

tunnel_up=false
if ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | grep -Eq '^(tun|wg)[0-9]+$'; then
  tunnel_up=true
fi

service_active=false
if systemctl is-active --quiet "${service_name}"; then
  service_active=true
fi

healthy=false
if [[ "${tunnel_up}" == true && "${service_active}" == true ]]; then
  healthy=true
fi

if [[ "${healthy}" == true && -n "${expected_org}" ]] && ! printf "%s" "${org}" | grep -qi "${expected_org}"; then
  healthy=false
fi

if [[ "${healthy}" == true ]]; then
  printf "IPVanish healthy: %s\n" "${org:-public network unknown}"
  exit 0
fi

printf "IPVanish unhealthy. service_active=%s tunnel_up=%s org=%s\n" "${service_active}" "${tunnel_up}" "${org:-unknown}" >&2

systemctl restart "${service_name}" || {
  sudo -u ces /home/ces/.local/bin/ipvanish-desktop-alert critical "IPVanish restart failed" "VPN appears down and systemd could not restart ${service_name}. Current network: ${org:-unknown}"
  exit 1
}

sleep 20

if systemctl is-active --quiet "${service_name}" && ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | grep -Eq '^(tun|wg)[0-9]+$'; then
  sudo -u ces /home/ces/.local/bin/ipvanish-desktop-alert normal "IPVanish restarted" "VPN was down and has been restarted. Current network: ${org:-unknown}"
  exit 0
fi

sudo -u ces /home/ces/.local/bin/ipvanish-desktop-alert critical "IPVanish is down" "Restart was attempted, but no VPN tunnel is active. Current network: ${org:-unknown}"
exit 1
